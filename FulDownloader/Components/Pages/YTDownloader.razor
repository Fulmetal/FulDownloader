@page "/"
@page "/YTDownloader"

@using YoutubeDLSharp
@using YoutubeDLSharp.Options
@using FFMpegCore
@using FFMpegCore.Enums
@using Models
@using FulDownloader.Extensions
@using FulDownloader.Services.Interfaces

<h2>YouTube Downloader</h2>
<br/>
<MudStack Justify="Justify.Center" AlignItems="AlignItems.Center">
    <MudStack Row="true" AlignItems="AlignItems.Start" Style="width: 100%">
    <MudTextField @bind-Value="YoutubeUrl" Label="Youtube URL" Variant="Variant.Outlined" FullWidth="false" Disabled="@(Busy || Downloading)"
                  Validation="@(new Func<string, string?>(ValidateUrl))" DebounceInterval="400"></MudTextField>
    <MudButton OnClick="GetVideoData" ButtonType="ButtonType.Button" Color="Color.Primary" Variant="Variant.Filled" Disabled="!UrlValid" Class="mt-4">Get data</MudButton>
    </MudStack>
    <br/>
    @if (Busy)
    {
        <MudProgressCircular Style="height:100px;width:100px;" Indeterminate="true" Color="Color.Primary">
            <ChildContent>Getting data</ChildContent>
        </MudProgressCircular>
    }
    <VideoDownload Disabled="Downloading" VideoData="VideoDataResult" VideoFormatSelected="GetVideo"></VideoDownload>
    <ProgressBar @ref="ProgBar" Visible="Downloading"></ProgressBar>
</MudStack>

@code {
    [Inject] IDownloadService DownloadService { get; set; } = null!;
    [Inject] ISnackbar Snackbar { get; set; } = null!;
    [Inject] IJSRuntime JsRuntime { get; set; } = null!;
    [Inject] ILoggerService<YTDownloader> Logger { get; set; } = null!;

    public string YoutubeUrl { get; set; } = string.Empty;
    bool UrlValid { get; set; }
    bool Busy { get; set; }
    bool Downloading { get; set; }
    
    private YoutubeDL? Ytdl { get; set; }
    private VideoDataModel? VideoDataResult { get; set; }
    private ProgressBar ProgBar { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
            Ytdl = new YoutubeDL
            {
                YoutubeDLPath = Globals.YtDlpPath,
                FFmpegPath = Globals.FfmpegPath,
                OutputFolder = Globals.DownloadPath
            };
    }

    private string? ValidateUrl(string arg)
    {
        VideoDataResult = null;
        const string errorMessage = "Invalid YouTube URL";
        if (string.IsNullOrWhiteSpace(YoutubeUrl) ||
            !Uri.TryCreate(YoutubeUrl, UriKind.Absolute, out var uri) ||
            (!uri.Host.Contains("youtube.com") && !uri.Host.Contains("youtu.be")))
        {
            UrlValid = false;
            StateHasChanged();
            return errorMessage;
        }

        UrlValid = true;
        StateHasChanged();
        return null;
    }

    async Task GetVideoData()
    {
        if (UrlValid)
        {
            Busy = true;
            try
            {
                if (Ytdl == null)
                    throw new NullReferenceException("Ytdl was not instantiated.");
                
                var result = await Ytdl.RunVideoDataFetch(YoutubeUrl);
                var videoDataList = result.Data.Formats.Where(x => x.Extension == "mp4" && x.VideoCodec.StartsWith("av01"))
                    .Select(format => new VideoFormatModel()
                    {
                        Resolution = format.Resolution,
                        FrameRate = format.FrameRate,
                        FormatNote = format.FormatNote,
                        FormatCode = format.FormatId,
                        Uri = format.Url
                    })
                    .ToList();

                VideoDataResult = new VideoDataModel
                {
                    VideoName = result.Data.Title.ToSafeFilename(),
                    VideoThumbnail = result.Data.Thumbnail,
                    VideoFormats = videoDataList,
                    VideoDuration = result.Data.Duration
                };
            }
            catch (Exception e)
            {
                Logger.LogError("Error retrieving video data.", e);
            }
            finally
            {
                Busy = false;
            }
        }
    }

    async Task GetVideo(VideoFormatModel formatModel)
    {
        if (VideoDataResult == null)
        {
            Logger.LogWarning("No video data loaded.");
            return;
        }
        
        Downloading = true;
        ProgBar.ResetProgress();
        StateHasChanged();

        try
        {
            if (!File.Exists(VideoDataResult.VideoFilePath))
            {
                await DownloadAndProcessVideo(formatModel);
                return;
            }
            
            var analysis = await FFProbe.AnalyseAsync(VideoDataResult.VideoFilePath);
            var resolution = $"{analysis.VideoStreams[0]?.Width}x{analysis.VideoStreams[0]?.Height}";
            if (resolution == formatModel.Resolution)
            {
                ProgBar.UpdateTitle("Fetching Video");
                await DownloadService.DownloadMp4Async(VideoDataResult.VideoFilename, VideoDataResult.VideoFilePath);
            }
            else
            {
                await DownloadAndProcessVideo(formatModel);
            }
            
            Logger.LogSuccess("Video download complete.");
        }
        catch (Exception e)
        {
            Logger.LogError("Error downloading video", e);
        }
        finally
        {
            Downloading = false;
            StateHasChanged();
        }
    }

    async Task DownloadAndProcessVideo(VideoFormatModel formatModel)
    {
        try
        {
            if (VideoDataResult == null)
            {
                Logger.LogWarning("No video data loaded.");
                return;
            }
            
            if (Ytdl != null)
            {
                var progress = new Progress<DownloadProgress>(p => ProgBar.UpdateProgress(p.Progress * 100));
                Action<double> encodingProgress = new Action<double>(p =>
                {
                    //progress value from 0 to 100
                    InvokeAsync(() =>
                    {
                        ProgBar.UpdateProgress(p);
                    });
                });
                var cts = new CancellationTokenSource();
                
                ProgBar.UpdateTitle("Downloading Video");
                var options = new OptionSet() { Format = formatModel.FormatCode };
                var vResult = await Ytdl.RunVideoDownload(YoutubeUrl, overrideOptions: options, progress: progress, ct: cts.Token);
                await JsRuntime.InvokeVoidAsync("consoleWriteLine", vResult);
                ProgBar.ResetProgress();
                ProgBar.UpdateTitle("Downloading Audio");
                var aResult = await Ytdl.RunAudioDownload(YoutubeUrl, progress: progress, ct: cts.Token);

                ProgBar.ResetProgress();
                ProgBar.UpdateTitle("Processing");
                await FFMpegArguments.FromFileInput(vResult.Data)
                    .AddFileInput(aResult.Data)
                    .OutputToFile(VideoDataResult.VideoFilePath, true, o => o
                        .CopyChannel()
                        .ForceFormat(VideoType.Mp4)
                        .WithFastStart()
                        .WithConstantRateFactor(27)
                        .WithSpeedPreset(Speed.VeryFast))
                    .NotifyOnProgress(encodingProgress, new TimeSpan(0, 0, Convert.ToInt32(VideoDataResult.VideoDuration)))
                    .ProcessAsynchronously();

                File.Delete(vResult.Data);
                File.Delete(aResult.Data);

                ProgBar.UpdateTitle("Fetching Video");
                StateHasChanged();
                await DownloadService.DownloadMp4Async(VideoDataResult.VideoFilename, VideoDataResult.VideoFilePath);
            }
        }
        catch (Exception e)
        {
            Logger.LogError("Error occurred during video download and processing", e);
        }
    }   
}