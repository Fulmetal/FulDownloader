@page "/Logs"
@using Infrastructure
@using Microsoft.EntityFrameworkCore
@using Serilog.Events

<h2>Logs</h2>
<br/>

<MudSelect T="string" SelectedValues="_options" SelectedValuesChanged="(x) => LogLevelsChanged(x)" Label="Log Level" Placeholder="Select log level" MultiSelection="true" SelectAll="true" SelectAllText="Show all" Adornment="Adornment.End" FullWidth="false">
    <MudSelectItem Value="@("Information")">
        <MudStack AlignItems="AlignItems.Center" Row="true">
            <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.Info" Color="Color.Info"/>
            <MudText>Information</MudText>
        </MudStack>
    </MudSelectItem>
    <MudSelectItem Value="@("Warning")">
        <MudStack AlignItems="AlignItems.Center" Row="true">
            <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.Warning" Color="Color.Warning"/>
            <MudText>Waring</MudText>
        </MudStack>
    </MudSelectItem>
    <MudSelectItem Value="@("Error")">
        <MudStack AlignItems="AlignItems.Center" Row="true">
            <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.Error" Color="Color.Error"/>
            <MudText>Error</MudText>
        </MudStack>
    </MudSelectItem>
    <MudSelectItem Value="@("Fatal")">
        <MudStack AlignItems="AlignItems.Center" Row="true">
            <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.WebAssetOff" Color="Color.Tertiary"/>
            <MudText>Fatal</MudText>
        </MudStack>
    </MudSelectItem>
</MudSelect>
<br/>

<MudTable Items="LogsList" RowsPerPage="10" Hover="true" Loading="_loading" LoadingProgressColor="Color.Primary">
    <HeaderContent>
        <MudTh>Level</MudTh>
        <MudTh>Timestamp</MudTh>
        <MudTh>Message</MudTh>
        <MudTh>Exception</MudTh>
        <MudTh>Properties</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Level">
            @if (context.Level == "Information")
            {
                <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.Info" Color="Color.Info"/>
            }
            @if (context.Level == "Warning")
            {
                <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.Warning" Color="Color.Warning"/>
            }
            @if (context.Level == "Error")
            {
                <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.Error" Color="Color.Error"/>
            }
            @if (context.Level == "Fatal")
            {
                <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.WebAssetOff" Color="Color.Tertiary"/>
            }
        </MudTd>
        <MudTd DataLabel="TimeStamp">@context.TimeStamp</MudTd>
        <MudTd DataLabel="RenderedMessage">@context.RenderedMessage</MudTd>
        <MudTd DataLabel="Exception">@context.Exception</MudTd>
        <MudTd DataLabel="Properties">@context.Properties</MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

@code {
    [Inject] ApplicationLogsDbContext LogsDbContext { get; set; } = null!;

    private List<LogDataModel> LogsList { get; set; } = new();
    private IReadOnlyCollection<string> _options = new List<string>()  {"Information", "Warning", "Error", "Fatal"};
    private bool _loading;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await GetLogs();
        }
    }

    private async Task LogLevelsChanged(IReadOnlyCollection<string> values)
    {
        _options = values; 
        await GetLogs();
    }

    private async Task GetLogs()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);
        
        LogsList = await LogsDbContext.Logs
            .Where(x => x.Level != null && _options.Contains(x.Level))
            .OrderByDescending(x => x.TimeStamp)
            .ToListAsync();

        foreach (var log in LogsList)
        {
            log.Properties = log.Properties?.Replace("{", "").Replace(";", "; ").Replace(",", ", "). Replace(":", " : ").Replace("}", "");
        }
        
        _loading = false;
        await InvokeAsync(StateHasChanged);
    }
}