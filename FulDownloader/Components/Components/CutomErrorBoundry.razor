@inherits ErrorBoundary
@inject ISnackbar Snackbar
@inject ILogger<CutomErrorBoundry> Logger

@if (CurrentException == null)
{
    @ChildContent
}
else if (ErrorContent != null)
{
    @ErrorContent(CurrentException)
}

@code {
    protected override Task OnErrorAsync(Exception exception)
    {
        // Log full exception with structured message
        Logger.LogError(exception, "Unhandled exception in component");

        // Notify user (avoid leaking sensitive details in production; show brief message)
        Snackbar.Add("An unexpected error occurred. The error has been logged.", Severity.Error);

        return Task.CompletedTask;
    }

}