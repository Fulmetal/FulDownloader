

<MudText Style="@(Visible ? "display: block;" : "display: none;")" Typo="Typo.body1">@Text</MudText>
<MudProgressLinear Style="@(Visible ? "display: block;" : "display: none;")" Color="Color.Primary" Value="@DownloadProgress" Class="my-7" />

@code {
    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public bool Visible { get; set; } = true;

    double DownloadProgress { get; set; }

    public void ResetProgress()
    {
        DownloadProgress = 0;
        StateHasChanged();
    }

    public void UpdateProgress(double value)
    {
        if (value > 0)
            DownloadProgress = value; 
        StateHasChanged();
    }

    public void UpdateTitle(string text, bool updateState = true)
    {
        Text = text;
        if (updateState)
            StateHasChanged();
    }

}